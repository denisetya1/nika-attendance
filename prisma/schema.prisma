generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid()) @map("id")
  email            String            @unique @map("email")
  name             String?           @map("name")
  password         String            @map("password")
  role             String            @default("employee")
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attendaceRecords AttendaceRecord[]
  forgotPassword   ForgotPassword[]

  @@map("users")
}

model AttendaceRecord {
  id                 String    @id @default(cuid()) @map("id")
  userId             String    @map("user_id")
  dateString         String    @map("date_string")
  checkInTime        DateTime  @map("check_in_time")
  checkInTimeString  String    @map("check_in_time_str")
  checkOutTime       DateTime? @map("check_out_time")
  checkOutTimeString String?   @map("check_out_time_str")
  photoUrl           String    @map("photo_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  photoUrlCheckout   String?   @map("photo_url_checkout")
  user               User      @relation(fields: [userId], references: [id])

  @@index([dateString, userId])
  @@map("attendace_records")
}

model ForgotPassword {
  id        String   @id @default(cuid()) @map("id")
  userId    String   @map("user_id")
  trxId     String   @map("trx_id")
  token     String   @map("token")
  expires   DateTime @map("expires")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@index([trxId, token])
  @@map("forgot_password")
}
